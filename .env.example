# Copy to .env.local for local development. This file intentionally contains placeholders only.
NODE_ENV=development
API_PORT=4000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://<db-user>:<db-password>@localhost:5432/<database>?schema=public
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
AUTH_SECRET=<generate-at-least-32-random-bytes>
AUTH_COOKIE_SAME_SITE=lax

# No real SMS adapter is included. OTP delivery remains unavailable until a reviewed provider
# adapter is implemented and configured. Do not use a console OTP provider in production.
SMS_PROVIDER=unconfigured
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_REQUESTS_PER_IP_PER_15_MINUTES=20
OTP_MAX_VERIFICATIONS_PER_IP_PER_15_MINUTES=30
OTP_RESEND_COOLDOWN_SECONDS=45

# Production uses private S3-compatible storage; enable bucket-level encryption and block public access.
DOCUMENT_STORAGE_PROVIDER=local
MEDICAL_DOCUMENT_MAX_UPLOAD_BYTES=15728640
MEDICAL_DOCUMENT_S3_BUCKET=<private-bucket-name>
MEDICAL_DOCUMENT_S3_REGION=<region>
MEDICAL_DOCUMENT_S3_ENDPOINT=
MEDICAL_DOCUMENT_S3_FORCE_PATH_STYLE=false
# Prefer the hosting provider's workload identity/role. Set static credentials only if required.
MEDICAL_DOCUMENT_S3_ACCESS_KEY_ID=
MEDICAL_DOCUMENT_S3_SECRET_ACCESS_KEY=

# Production uploads require a reachable ClamAV daemon.
MEDICAL_DOCUMENT_SCANNER=development-noop
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# Optional local-only test-account sign-in; keep disabled outside local testing.
DEV_PASSWORD_AUTH_ENABLED=false
DEV_TEST_PHONE=<synthetic-test-phone>
DEV_TEST_PASSWORD=<unique-random-password-at-least-16-characters>
NEXT_PUBLIC_DEV_PASSWORD_AUTH_ENABLED=false
NEXT_PUBLIC_MEDICAL_DOCUMENT_MAX_UPLOAD_BYTES=15728640

MEDICAL_SHARE_MAX_DURATION_MINUTES=60
OCR_PROVIDER=disabled
AI_ASSISTANT_ENABLED=false
AI_ASSISTANT_PROVIDER=disabled
OPENAI_API_KEY=
AI_ASSISTANT_MODEL=gpt-4.1-mini
AI_ASSISTANT_EMBEDDING_MODEL=text-embedding-3-small
BP_SYSTOLIC_MIN=40
BP_SYSTOLIC_MAX=300
BP_DIASTOLIC_MIN=20
BP_DIASTOLIC_MAX=200
BP_HEART_RATE_MIN=20
BP_HEART_RATE_MAX=250
GLUCOSE_MG_DL_MIN=1
GLUCOSE_MG_DL_MAX=2000
GLUCOSE_MMOL_L_MIN=0.1
GLUCOSE_MMOL_L_MAX=111.1

# Local OCR is disabled by default. Enable only after provisioning Tesseract language data.
OCR_LANGUAGES=eng
OCR_LANG_PATH=

